# ============================================================
# NEIGHBOURHOOD-RADIUS SIMILARITY BY PROFITABILITY CLASS
#
# For each profitability class and year:
#   1. Fishing hours are expressed as proportions of the
#      class-specific annual total.
#   2. Proportions are smoothed using neighbouring C-squares
#      within each selected radius.
#   3. The smoothed spatial distribution is compared with the
#      selected reference year using cosine similarity.
#
# The analysis therefore compares relative spatial
# distributions, not absolute fishing hours.
# ============================================================


# =========================
# LIBRARY
# =========================

library(spdep)


# =========================
# SETTINGS
# =========================

reference_year <- 2019

radii_km <- c(
  5,
  10,
  20,
  30,
  50,
  75,
  100
)

radii_m <- radii_km * 1000


# =========================
# 1. CHECK REFERENCE YEAR
# =========================

if (!reference_year %in% years_kan_lk) {
  stop(
    "Reference year ",
    reference_year,
    " is not available in years_kan_lk."
  )
}


# =========================
# 2. CREATE A COMMON C-SQUARE GEOMETRY
#
# Both classes and all years must use exactly the same
# C-square rows and row ordering.
# =========================

similarity_csquares <- tibble::tibble(
  Csquare = all_kan_lk_csquares
) %>%
  csquares::as_csquares(
    csquares = "Csquare"
  ) %>%
  sf::st_as_sf()

class(similarity_csquares) <- setdiff(
  class(similarity_csquares),
  "csquares"
)

similarity_csquares <- similarity_csquares %>%
  sf::st_make_valid() %>%
  sf::st_transform(3067)


# Use C-square centroids for neighbourhood distances

similarity_centroids <- similarity_csquares %>%
  sf::st_centroid()

similarity_coordinates <- sf::st_coordinates(
  similarity_centroids
)


# =========================
# 3. BUILD CLASS-YEAR PROPORTION DATA
#
# vms_kan_lk_complete already contains zeros for missing
# class-year-C-square combinations.
#
# Recalculate proportions here from FishingHours so the
# similarity analysis is self-contained.
# =========================

kan_lk_similarity_long <- vms_kan_lk_complete %>%
  dplyr::group_by(
    Year,
    kan_lk
  ) %>%
  dplyr::mutate(
    AnnualFishingHours = sum(
      FishingHours,
      na.rm = TRUE
    ),

    FishingHoursProportion = dplyr::if_else(
      AnnualFishingHours > 0,
      FishingHours / AnnualFishingHours,
      NA_real_
    )
  ) %>%
  dplyr::ungroup() %>%
  dplyr::select(
    Year,
