# ============================================================
# FISHING-HOUR MAPS BY PROFITABILITY CLASS
#
# Inputs:
#   orig/Kannattavuusluokka.xlsx
#   D$table1
#
# Matching:
#   D$table1$VE_ID = kannattavuusluokka$alus
#   D$table1$Year  = kannattavuusluokka$vuosi
#
# Outputs:
#   p_kan_lk_1
#   p_kan_lk_2
#   out/fishing_hours_kan_lk_1.png
#   out/fishing_hours_kan_lk_2.png
# ============================================================


# =========================
# LIBRARIES
# =========================

library(readxl)
library(dplyr)
library(sf)
library(csquares)
library(ggplot2)
library(ggnewscale)

rm(filter)

# =========================
# 1. READ PROFITABILITY DATA
# =========================

kannattavuusluokka <- readxl::read_excel(
  file.path(
    "orig",
    "Kannattavuusluokka.xlsx"
  )
) %>%
  dplyr::transmute(
    VE_ID = trimws(
      as.character(alus)
    ),
    Year = as.integer(vuosi),
    AER_SEGMENT = as.character(AER_SEGMENT),
    kan_lk = as.integer(kan_lk)
  ) %>%
  dplyr::filter(
    !is.na(VE_ID),
    VE_ID != "",
    !is.na(Year),
    kan_lk %in% c(1, 2)
  )


# =========================
# 2. CHECK DUPLICATE KEYS
#
# Each vessel-year should preferably have one kan_lk value.
# Identical duplicate rows are removed.
# Conflicting classifications stop the analysis.
# =========================

kan_lk_conflicts <- kannattavuusluokka %>%
  dplyr::group_by(
    VE_ID,
    Year
  ) %>%
  dplyr::summarise(
    n_rows = dplyr::n(),
    n_classes = dplyr::n_distinct(
      kan_lk,
      na.rm = TRUE
    ),
    classes = paste(
      sort(unique(kan_lk)),
      collapse = ";"
    ),
    .groups = "drop"
  ) %>%
  dplyr::filter(
    n_classes > 1
  )

if (nrow(kan_lk_conflicts) > 0) {

  print(kan_lk_conflicts)

  stop(
    "Some vessel-year combinations have more than one ",
    "kan_lk value. Resolve these conflicts before continuing."
  )
}

kannattavuusluokka <- kannattavuusluokka %>%
  dplyr::distinct(
    VE_ID,
    Year,
    .keep_all = TRUE
  )


# =========================
# 3. PREPARE VMS DATA
# =========================

required_vms_columns <- c(
  "VE_ID",
  "Year",
  "Csquare",
  "FishingHour"
)

missing_vms_columns <- setdiff(
  required_vms_columns,
  names(D$table1)
)

if (length(missing_vms_columns) > 0) {

  stop(
    "The following required columns are missing from D$table1: ",
    paste(
      missing_vms_columns,
      collapse = ", "
    )
  )
}

vms_for_kan_lk <- D$table1 %>%
  dplyr::transmute(
    VE_ID = trimws(
      as.character(VE_ID)
    ),
    Year = as.integer(Year),
    Csquare = as.character(Csquare),
    FishingHour = as.numeric(FishingHour)
  ) %>%
  dplyr::filter(
    !is.na(VE_ID),
    VE_ID != "",
    !is.na(Year),
    !is.na(Csquare),
    Csquare != "",
    !is.na(FishingHour)
  )


# =========================
# 4. MATCH VMS AND PROFITABILITY CLASSES
# =========================

vms_kan_lk <- vms_for_kan_lk %>%
  dplyr::left_join(
    kannattavuusluokka %>%
      dplyr::select(
        VE_ID,
        Year,
        kan_lk
      ),
    by = c(
      "VE_ID",
      "Year"
    )
  )


# =========================
# 5. MATCHING SUMMARY
# =========================

matching_summary <- vms_kan_lk %>%
  dplyr::summarise(
    n_vms_rows = dplyr::n(),

    n_matched_rows = sum(
      !is.na(kan_lk)
    ),

    n_unmatched_rows = sum(
      is.na(kan_lk)
    ),

    matched_fishing_hours = sum(
      FishingHour[!is.na(kan_lk)],
      na.rm = TRUE
    ),

    unmatched_fishing_hours = sum(
      FishingHour[is.na(kan_lk)],
      na.rm = TRUE
    ),

    total_fishing_hours = sum(
      FishingHour,
      na.rm = TRUE
    ),

    matched_hours_percent = dplyr::if_else(
      total_fishing_hours > 0,
      100 *
        matched_fishing_hours /
        total_fishing_hours,
      NA_real_
    )
  )

cat("\n========================================\n")
cat("PROFITABILITY-CLASS MATCHING SUMMARY\n")
cat("========================================\n")

print(matching_summary)


# Vessel-year combinations without a profitability class

unmatched_vessel_years <- vms_kan_lk %>%
  dplyr::filter(
    is.na(kan_lk)
  ) %>%
  dplyr::group_by(
    VE_ID,
    Year
  ) %>%
  dplyr::summarise(
    FishingHours = sum(
      FishingHour,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  dplyr::arrange(
    dplyr::desc(FishingHours)
  )

write.csv(
  unmatched_vessel_years,
  file.path(
    outPath,
    "unmatched_vessel_years_kannattavuusluokka.csv"
  ),
  row.names = FALSE
)


# =========================
# 6. CALCULATE MEAN ANNUAL PERCENTAGE OF FISHING HOURS
#
# Workflow:
#   1. Sum fishing hours by year, class, and C-square.
#   2. Calculate total annual fishing hours within each class.
#   3. Express each C-square as a percentage of the annual
#      total for that profitability class.
#   4. Complete missing year-class-cell combinations with zero.
#   5. Calculate the mean annual percentage for each C-square.
#
# Therefore, percentages sum to 100% within each profitability
# class and year before averaging across years.
# =========================

years_kan_lk <- sort(
  intersect(
    unique(vms_kan_lk$Year),
    unique(kannattavuusluokka$Year)
  )
)

if (length(years_kan_lk) == 0) {
  stop(
    "No common years were found between D$table1 and ",
    "Kannattavuusluokka.xlsx."
  )
}


# --------------------------------------------------
# Sum fishing hours by year, class, and C-square
# --------------------------------------------------

vms_kan_lk_year_cell <- vms_kan_lk %>%
  dplyr::filter(
    !is.na(kan_lk),
    kan_lk %in% c(1, 2),
    Year %in% years_kan_lk
  ) %>%
  dplyr::group_by(
    Year,
    kan_lk,
    Csquare
  ) %>%
  dplyr::summarise(
    FishingHours = sum(
      FishingHour,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


# --------------------------------------------------
# Calculate annual total hours within each class
# --------------------------------------------------

kan_lk_annual_totals <- vms_kan_lk_year_cell %>%
  dplyr::group_by(
    Year,
    kan_lk
  ) %>%
  dplyr::summarise(
    AnnualFishingHours = sum(
      FishingHours,
      na.rm = TRUE
    ),
    .groups = "drop"
  )


# --------------------------------------------------
# Check that each class-year has positive fishing hours
# --------------------------------------------------

invalid_class_years <- kan_lk_annual_totals %>%
  dplyr::filter(
    !is.finite(AnnualFishingHours),
    AnnualFishingHours <= 0
  )

if (nrow(invalid_class_years) > 0) {

  print(invalid_class_years)

  stop(
    "One or more profitability class-year combinations have ",
    "zero or invalid total fishing hours."
  )
}


# --------------------------------------------------
# Express each C-square as percentage of the annual
# total fishing hours within its profitability class
# --------------------------------------------------

vms_kan_lk_year_cell <- vms_kan_lk_year_cell %>%
  dplyr::left_join(
    kan_lk_annual_totals,
    by = c(
      "Year",
      "kan_lk"
    )
  ) %>%
  dplyr::mutate(
    FishingHoursPercent = 100 *
      FishingHours /
      AnnualFishingHours
  )


# --------------------------------------------------
# All C-squares observed in either profitability class
# --------------------------------------------------

all_kan_lk_csquares <- sort(
  unique(
    vms_kan_lk_year_cell$Csquare
  )
)


# --------------------------------------------------
# Complete year x class x C-square combinations
#
# A missing class-year-cell combination means zero fishing
# activity in that cell during that year.
# --------------------------------------------------

vms_kan_lk_complete <- tidyr::complete(
  vms_kan_lk_year_cell,
  Year = years_kan_lk,
  kan_lk = c(1L, 2L),
  Csquare = all_kan_lk_csquares,
  fill = list(
    FishingHours = 0,
    FishingHoursPercent = 0
  )
)


# --------------------------------------------------
# Mean annual percentage by class and C-square
# --------------------------------------------------

kan_lk_mean_csquare <- vms_kan_lk_complete %>%
  dplyr::group_by(
    kan_lk,
    Csquare
  ) %>%
  dplyr::summarise(
    MeanAnnualPercent = mean(
      FishingHoursPercent,
      na.rm = TRUE
    ),
    .groups = "drop"
  ) %>%
  dplyr::filter(
    MeanAnnualPercent > 0
  )


# --------------------------------------------------
# Confirm that mean percentages sum to approximately
# 100% within each profitability class
# --------------------------------------------------

percentage_check <- kan_lk_mean_csquare %>%
  dplyr::group_by(
    kan_lk
  ) %>%
  dplyr::summarise(
    sum_mean_annual_percent = sum(
      MeanAnnualPercent,
      na.rm = TRUE
    ),
    .groups = "drop"
  )

cat("\n========================================\n")
cat("PERCENTAGE SUM CHECK BY PROFITABILITY CLASS\n")
cat("========================================\n")

print(percentage_check)

# =========================
# 7. CONVERT C-SQUARES TO SF
# =========================

kan_lk_sf <- csquares::as_csquares(
  kan_lk_mean_csquare,
  csquares = "Csquare"
) %>%
  sf::st_as_sf()

class(kan_lk_sf) <- setdiff(
  class(kan_lk_sf),
  "csquares"
)

kan_lk_sf <- kan_lk_sf %>%
  sf::st_make_valid() %>%
  sf::st_transform(4326)


kan_lk_1_sf <- kan_lk_sf %>%
  dplyr::filter(
    kan_lk == 1
  )

kan_lk_2_sf <- kan_lk_sf %>%
  dplyr::filter(
    kan_lk == 2
  )


# =========================
# 8. SUBDIVISION GUIDE LINES
# =========================

lat_lines <- sf::st_as_sf(
  data.frame(
    id = c(
      "63.5",
      "60.5"
    ),
    geometry = sf::st_sfc(

      # SD30/SD31 separator used in the other maps
      sf::st_linestring(
        matrix(
          c(
            17, 63.5,
            23, 63.5
          ),
          ncol = 2,
          byrow = TRUE
        )
      ),

      # Southern study-area guide line
      sf::st_linestring(
        matrix(
          c(
            17, 60.5,
            22, 60.5
          ),
          ncol = 2,
          byrow = TRUE
        )
      ),

      crs = 4326
    )
  )
)


# =========================
# 9. COMMON FILL SCALE
#
# A shared limit makes maps for classes 1 and 2 directly
# comparable.
# =========================

kan_lk_fill_max <- max(
  kan_lk_sf$MeanAnnualPercent,
  na.rm = TRUE
)

if (
  !is.finite(kan_lk_fill_max) ||
  kan_lk_fill_max <= 0
) {
  stop(
    "No positive mean annual fishing percentages were available for ",
    "profitability classes 1 and 2."
  )
}


# =========================
# 10. MAP FUNCTION
# =========================
# =========================
# 10. MAP FUNCTION
#
# value_column:
#   Mean maps   = "MeanAnnualPercent"
#   Yearly maps = "FishingHoursPercent"
#
# The function returns a plot but does not save it.
# All maps are saved later into one multipage PDF.
# =========================

plot_kan_lk_fishing <- function(
    fishing_sf,
    class_number,
    value_column,
    legend_title,
    wind,
    cable,
    coast,
    lat_lines,
    fill_max
) {

  # --------------------------------------------------
  # Validate mapped column
  # --------------------------------------------------

  if (!value_column %in% names(fishing_sf)) {
    stop(
      "Column '",
      value_column,
      "' was not found in fishing_sf. Available columns: ",
      paste(names(fishing_sf), collapse = ", ")
    )
  }

  if (nrow(fishing_sf) == 0) {
    warning(
      "No fishing C-squares available for ",
      class_number,
      "."
    )
  }

  wind_plot <- wind %>%
    dplyr::mutate(
      Layer = "Wind area"
    )

  cable_plot <- cable %>%
    dplyr::mutate(
      Layer = "Cable corridor"
    )

  p <- ggplot() +

    # Fishing distribution
    geom_sf(
      data = fishing_sf,
      aes(
        fill = .data[[value_column]]
      ),
      colour = NA
    ) +

    scale_fill_viridis_c(
      option = "inferno",
      direction = -1,
      limits = c(
        0,
        fill_max
      ),
      oob = scales::squish,
      name = legend_title,
      guide = guide_colourbar(
        order = 1
      )
    ) +

    # Wind area outlines
    ggnewscale::new_scale_colour() +

    geom_sf(
      data = wind_plot,
      aes(
        colour = Layer
      ),
      fill = NA,
      alpha = 0.8,
      linewidth = 0.45
    ) +

    scale_colour_manual(
      values = c(
        "Wind area" = "#20262d"
      ),
      name = NULL,
      guide = guide_legend(
        order = 2
      )
    ) +

    # Cable corridors
    ggnewscale::new_scale_fill() +

    geom_sf(
      data = cable_plot,
      aes(
        fill = Layer
      ),
      colour = NA,
      alpha = 0.4
    ) +

    scale_fill_manual(
      values = c(
        "Cable corridor" = "#5e3d60"
      ),
      name = NULL,
      guide = guide_legend(
        order = 3
      )
    ) +

    # Subdivision guide lines
    geom_sf(
      data = lat_lines,
      colour = "black",
      linetype = "dashed",
      linewidth = 0.6
    ) +

    # Land
    plot_base_layers(
      baltic = coast
    ) +

    coord_sf(
      xlim = c(17, 26),
      ylim = c(60, 66),
      expand = FALSE
    ) +

    base_map() +

    add_map_decorations() +

    labs(
      title = paste(
        "Fishing distribution, profitability class",
        class_number
      )
    )

  return(p)
}

# =========================
# 11. CREATE MEAN MAPS
#
# These maps show the mean annual percentage distribution
# across all available years.
# =========================

p_kan_lk_1 <- plot_kan_lk_fishing(
  fishing_sf = kan_lk_1_sf,
  class_number = 1,
  value_column = "MeanAnnualPercent",
  legend_title = paste0(
    "Mean annual share\n",
    "of fishing hours (%)"
  ),
  wind = S$wind,
  cable = S$cable_full,
  coast = S$coast,
  lat_lines = lat_lines,
  fill_max = kan_lk_fill_max
)

p_kan_lk_2 <- plot_kan_lk_fishing(
  fishing_sf = kan_lk_2_sf,
  class_number = 2,
  value_column = "MeanAnnualPercent",
  legend_title = paste0(
    "Mean annual share\n",
    "of fishing hours (%)"
  ),
  wind = S$wind,
  cable = S$cable_full,
  coast = S$coast,
  lat_lines = lat_lines,
  fill_max = kan_lk_fill_max
)


# Combined mean page

p_kan_lk_mean_combined <-
  p_kan_lk_1 +
  p_kan_lk_2 +
  patchwork::plot_layout(
    ncol = 2,
    guides = "collect"
  ) +
  patchwork::plot_annotation(
    title = paste0(
      "Mean fishing distribution by profitability class, ",
      min(years_kan_lk),
      "–",
      max(years_kan_lk)
    )
  ) &

  theme(
    legend.position = "bottom"
  )

print(p_kan_lk_mean_combined)



# =========================
# 13. EXPORT AGGREGATED DATA
# =========================

write.csv(
  sf::st_drop_geometry(
    kan_lk_sf
  ),
  file.path(
    outPath,
    "fishing_hours_by_kan_lk_csquare.csv"
  ),
  row.names = FALSE
)

# =========================
# 14. PREPARE YEARLY SPATIAL DATA
#
# FishingHoursPercent is the percentage of each class's
# total fishing hours in that particular year.
# =========================

kan_lk_year_sf <- vms_kan_lk_year_cell %>%
  dplyr::filter(
    FishingHours > 0,
    FishingHoursPercent > 0
  ) %>%
  csquares::as_csquares(
    csquares = "Csquare"
  ) %>%
  sf::st_as_sf()

class(kan_lk_year_sf) <- setdiff(
  class(kan_lk_year_sf),
  "csquares"
)

kan_lk_year_sf <- kan_lk_year_sf %>%
  sf::st_make_valid() %>%
  sf::st_transform(4326)


# --------------------------------------------------
# Shared scale across all yearly maps
#
# Using the same maximum allows direct comparison between
# years and profitability classes.
# --------------------------------------------------

fill_max_yearly <- max(
  kan_lk_year_sf$FishingHoursPercent,
  na.rm = TRUE
)

if (
  !is.finite(fill_max_yearly) ||
  fill_max_yearly <= 0
) {
  stop(
    "No positive yearly fishing-hour percentages were found."
  )
}


years_available <- sort(
  unique(
    kan_lk_year_sf$Year
  )
)


# =========================
# 15. CREATE ONE MULTIPAGE PDF
#
# Page 1:
#   Mean distribution across all years
#
# Following pages:
#   One page per year, with profitability classes 1 and 2
#   shown side by side.
# =========================

pdf_file <- file.path(
  outPath,
  "fishing_distribution_by_profitability_class.pdf"
)

grDevices::pdf(
  file = pdf_file,
  width = 14,
  height = 7,
  onefile = TRUE
)


# --------------------------------------------------
# First page: mean annual distributions
# --------------------------------------------------

print(
  p_kan_lk_mean_combined
)


# --------------------------------------------------
# Following pages: one page for each year
# --------------------------------------------------

for (year_i in years_available) {

  sf_1 <- kan_lk_year_sf %>%
    dplyr::filter(
      Year == year_i,
      kan_lk == 1
    )

  sf_2 <- kan_lk_year_sf %>%
    dplyr::filter(
      Year == year_i,
      kan_lk == 2
    )


  p1_year <- plot_kan_lk_fishing(
    fishing_sf = sf_1,
    class_number = 1,
    value_column = "FishingHoursPercent",
    legend_title = paste0(
      "Share of annual\n",
      "fishing hours (%)"
    ),
    wind = S$wind,
    cable = S$cable_full,
    coast = S$coast,
    lat_lines = lat_lines,
    fill_max = fill_max_yearly
  )


  p2_year <- plot_kan_lk_fishing(
    fishing_sf = sf_2,
    class_number = 2,
    value_column = "FishingHoursPercent",
    legend_title = paste0(
      "Share of annual\n",
      "fishing hours (%)"
    ),
    wind = S$wind,
    cable = S$cable_full,
    coast = S$coast,
    lat_lines = lat_lines,
    fill_max = fill_max_yearly
  )


  p_year_combined <-
    p1_year +
    p2_year +
    patchwork::plot_layout(
      ncol = 2,
      guides = "collect"
    ) +
    patchwork::plot_annotation(
      title = paste(
        "Fishing distribution by profitability class,",
        year_i
      )
    ) &

    theme(
      legend.position = "bottom"
    )


  print(
    p_year_combined
  )
}


grDevices::dev.off()

message(
  "Multipage PDF written to: ",
  pdf_file
)


# =========================
# VESSEL MATCHING AND CLASS COUNTS BY YEAR
#
# Counts are based on distinct VE_ID + Year combinations.
#
# The table reports:
#   - all distinct VMS vessels in each year
#   - vessels found in Kannattavuusluokka.xlsx
#   - unmatched VMS vessels
#   - class 1 vessels
#   - class 2 vessels
#   - percentage of VMS vessels matched
# =========================


# --------------------------------------------------
# One row per VMS vessel and year
# --------------------------------------------------

vms_vessel_year <- vms_for_kan_lk %>%
  dplyr::distinct(
    Year,
    VE_ID
  )


# --------------------------------------------------
# Attach profitability class
# --------------------------------------------------

vessel_year_classes <- vms_vessel_year %>%
  dplyr::left_join(
    kannattavuusluokka %>%
      dplyr::select(
        VE_ID,
        Year,
        kan_lk
      ),
    by = c(
      "VE_ID",
      "Year"
    )
  )


# --------------------------------------------------
# Annual vessel matching and class summary
# --------------------------------------------------

vessel_class_summary_year <- vessel_year_classes %>%
  dplyr::group_by(
    Year
  ) %>%
  dplyr::summarise(
    n_vms_vessels = dplyr::n_distinct(
      VE_ID
    ),

    n_vessels_found = dplyr::n_distinct(
      VE_ID[!is.na(kan_lk)]
    ),

    n_vessels_not_found = dplyr::n_distinct(
      VE_ID[is.na(kan_lk)]
    ),

    n_class_1_vessels = dplyr::n_distinct(
  VE_ID[!is.na(kan_lk) & kan_lk == 1]
),

n_class_2_vessels = dplyr::n_distinct(
  VE_ID[!is.na(kan_lk) & kan_lk == 2]
),

    matched_vessels_percent = dplyr::if_else(
      n_vms_vessels > 0,
      100 *
        n_vessels_found /
        n_vms_vessels,
      NA_real_
    ),

    all_vessels_found =
      n_vessels_not_found == 0,

    .groups = "drop"
  ) %>%
  dplyr::mutate(
    matched_vessels_percent = round(
      matched_vessels_percent,
      1
    )
  ) %>%
  dplyr::arrange(
    Year
  )


# --------------------------------------------------
# Overall vessel matching summary
# --------------------------------------------------

vessel_class_summary_total <- vessel_year_classes %>%
  dplyr::summarise(
    n_vessel_year_combinations = dplyr::n(),

    n_vessel_years_found = sum(
      !is.na(kan_lk)
    ),

    n_vessel_years_not_found = sum(
      is.na(kan_lk)
    ),

    matched_vessel_years_percent = dplyr::if_else(
      n_vessel_year_combinations > 0,
      100 *
        n_vessel_years_found /
        n_vessel_year_combinations,
      NA_real_
    ),

    all_vessel_years_found =
      n_vessel_years_not_found == 0
  ) %>%
  dplyr::mutate(
    matched_vessel_years_percent = round(
      matched_vessel_years_percent,
      1
    )
  )


# --------------------------------------------------
# Unmatched vessels by year
# --------------------------------------------------

unmatched_vessels_by_year <- vessel_year_classes %>%
  dplyr::filter(
    is.na(kan_lk)
  ) %>%
  dplyr::arrange(
    Year,
    VE_ID
  )


# --------------------------------------------------
# Vessel-years present in kannattavuusluokka
# but missing from VMS
# --------------------------------------------------

kan_vessel_year <- kannattavuusluokka %>%
  distinct(
    Year,
    VE_ID,
    kan_lk
  )

missing_from_vms <- kan_vessel_year %>%
  anti_join(
    vms_vessel_year,
    by = c(
      "Year",
      "VE_ID"
    )
  ) %>%
  arrange(
    Year,
    VE_ID
  )

cat("\n========================================\n")
cat("VESSELS IN KANNATTAVUUSLUOKKA BUT NOT IN VMS\n")
