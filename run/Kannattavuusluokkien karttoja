# =========================
# 6. COSINE-SIMILARITY FUNCTION
# =========================

cosine_similarity <- function(
    x,
    y
) {

  numerator <- sum(
    x * y,
    na.rm = TRUE
  )

  denominator <- sqrt(
    sum(
      x^2,
      na.rm = TRUE
    ) *
      sum(
        y^2,
        na.rm = TRUE
      )
  )

  if (
    !is.finite(denominator) ||
    denominator == 0
  ) {
    return(NA_real_)
  }

  numerator / denominator
}

# =========================
# 7. CALCULATE SIMILARITY AT ONE RADIUS
# =========================

calculate_similarity_at_radius <- function(
    radius_m,
    proportion_matrix,
    class_number
) {

  # --------------------------------------------------
  # Define neighbours within the selected radius
  # --------------------------------------------------

  neighbours <- spdep::dnearneigh(
    similarity_coordinates,
    d1 = 0,
    d2 = radius_m
  )

  # --------------------------------------------------
  # Create row-standardised neighbourhood weights
  # --------------------------------------------------

  neighbour_weights <- spdep::nb2listw(
    neighbours,
    style = "W",
    zero.policy = TRUE
  )

  # --------------------------------------------------
  # Function for neighbourhood smoothing
  # --------------------------------------------------

  smooth_distribution <- function(proportions) {

    spdep::lag.listw(
      neighbour_weights,
      proportions,
      zero.policy = TRUE
    )
  }

  # --------------------------------------------------
  # Smooth the reference-year distribution
  # --------------------------------------------------

  reference_column <- as.character(
    reference_year
  )

  if (!reference_column %in% names(proportion_matrix)) {
    stop(
      "Reference year column ",
      reference_column,
      " was not found in the proportion matrix for class ",
      class_number,
      "."
    )
  }

  reference_distribution <- smooth_distribution(
    proportion_matrix[[reference_column]]
  )

  # --------------------------------------------------
  # Compare every year with the reference year
  # --------------------------------------------------

  purrr::map_dfr(
    years_kan_lk,
    function(year_i) {

      year_column <- as.character(
        year_i
      )

      if (!year_column %in% names(proportion_matrix)) {
        stop(
          "Year column ",
          year_column,
          " was not found in the proportion matrix for class ",
          class_number,
          "."
        )
      }

      annual_distribution <- smooth_distribution(
        proportion_matrix[[year_column]]
      )

      tibble::tibble(
        kan_lk = class_number,
        radius_km = radius_m / 1000,
        Year = year_i,
        reference_year = reference_year,
        cosine_similarity = cosine_similarity(
          annual_distribution,
          reference_distribution
        )
      )
    }
  )
}

# =========================
# 8. RUN ALL RADII FOR BOTH CLASSES
# =========================

similarity_by_radius_class_1 <- purrr::map_dfr(
