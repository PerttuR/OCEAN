    names(reference_matrix)
) {
  stop(
    "Reference year ",
    common_reference_year,
    " is not available in the class ",
    common_reference_class,
    " proportion matrix."
  )
}


# =========================
# 2. CALCULATE SIMILARITY AT ONE RADIUS
# =========================

calculate_similarity_to_class1_2019 <- function(
    radius_m
) {

  # ----------------------------------------------------------
  # Define neighbouring C-squares
  # ----------------------------------------------------------

  neighbours <- spdep::dnearneigh(
    similarity_coordinates,
    d1 = 0,
    d2 = radius_m
  )

  # Number of C-squares without neighbours at this radius
  n_isolated <- sum(
    spdep::card(neighbours) == 0
  )

  if (n_isolated > 0) {
    message(
      "Radius ",
      radius_m / 1000,
      " km: ",
      n_isolated,
      " C-squares have no neighbours."
    )
  }

  # ----------------------------------------------------------
  # Create row-standardised neighbourhood weights
  # ----------------------------------------------------------

  neighbour_weights <- spdep::nb2listw(
    neighbours,
    style = "W",
    zero.policy = TRUE
  )

  # ----------------------------------------------------------
  # Function for smoothing one spatial distribution
  # ----------------------------------------------------------

  smooth_distribution <- function(
      proportions
  ) {

    spdep::lag.listw(
      neighbour_weights,
      as.numeric(proportions),
      zero.policy = TRUE
    )
  }

  # ----------------------------------------------------------
  # Common reference:
  # profitability class 1 in 2019
  # ----------------------------------------------------------

  reference_distribution <- smooth_distribution(
    class_1_proportion_matrix[[as.character(common_reference_year)]]
  )

  # ----------------------------------------------------------
  # Compare all class 1 years with class 1 in 2019
  # ----------------------------------------------------------

  class_1_results <- purrr::map_dfr(
    years_kan_lk,
    function(year_i) {

      annual_distribution <- smooth_distribution(
        class_1_proportion_matrix[[as.character(year_i)]]
      )

      tibble::tibble(
        radius_km = radius_m / 1000,
        kan_lk = 1L,
        Year = year_i,
        reference_class = common_reference_class,
        reference_year = common_reference_year,
        cosine_similarity = cosine_similarity(
          annual_distribution,
          reference_distribution
        )
      )
    }
  )

  # ----------------------------------------------------------
  # Compare all class 2 years with class 1 in 2019
  # ----------------------------------------------------------

  class_2_results <- purrr::map_dfr(
    years_kan_lk,
    function(year_i) {

      annual_distribution <- smooth_distribution(
        class_2_proportion_matrix[[as.character(year_i)]]
      )

      tibble::tibble(
        radius_km = radius_m / 1000,
        kan_lk = 2L,
        Year = year_i,
        reference_class = common_reference_class,
        reference_year = common_reference_year,
        cosine_similarity = cosine_similarity(
          annual_distribution,
          reference_distribution
        )
      )
    }
  )

  # ----------------------------------------------------------
  # Combine both profitability classes
  # ----------------------------------------------------------

  dplyr::bind_rows(
    class_1_results,
    class_2_results
  )
}


