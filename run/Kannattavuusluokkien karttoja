# ============================================================
# WIND AND CABLE IMPACT BY PROFITABILITY CLASS AND YEAR
#
# Percentages are calculated against the total fishing hours
# of the corresponding class and year.
# ============================================================

wind_proj_kan <- S$wind %>%
  sf::st_make_valid() %>%
  sf::st_transform(3067)

cable_proj_kan <- S$cable_full %>%
  sf::st_make_valid() %>%
  sf::st_transform(3067)


kan_lk_impact_year <- purrr::map_dfr(
  years_available,
  function(year_i) {

    purrr::map_dfr(
      c(1L, 2L),
      function(class_i) {

        fishing_sf <- kan_lk_year_sf %>%
          dplyr::filter(
            Year == year_i,
            kan_lk == class_i
          ) %>%
          sf::st_transform(3067)

        if (nrow(fishing_sf) == 0) {

          return(
            tibble::tibble(
              Year = year_i,
              kan_lk = class_i,
              total_fishing_hours = 0,
              wind_impact_percent = NA_real_,
              cable_impact_percent = NA_real_,
              total_impact_percent = NA_real_
            )
          )
        }

        wind_flag <- lengths(
          sf::st_intersects(
            fishing_sf,
            wind_proj_kan
          )
        ) > 0

        cable_flag <- lengths(
          sf::st_intersects(
            fishing_sf,
            cable_proj_kan
          )
        ) > 0

        cable_only_flag <- cable_flag & !wind_flag

        total_hours <- sum(
          fishing_sf$FishingHours,
          na.rm = TRUE
        )

        wind_hours <- sum(
          fishing_sf$FishingHours[wind_flag],
          na.rm = TRUE
        )

        cable_hours <- sum(
          fishing_sf$FishingHours[cable_only_flag],
          na.rm = TRUE
        )

        tibble::tibble(
          Year = year_i,
          kan_lk = class_i,
          total_fishing_hours = total_hours,

          wind_impact_percent = dplyr::if_else(
            total_hours > 0,
            100 * wind_hours / total_hours,
            NA_real_
          ),

          cable_impact_percent = dplyr::if_else(
            total_hours > 0,
            100 * cable_hours / total_hours,
            NA_real_
          ),

          total_impact_percent = dplyr::if_else(
            total_hours > 0,
            100 *
              (wind_hours + cable_hours) /
              total_hours,
            NA_real_
          )
        )
      }
    )
  }
)


