# SPATIAL SIMILARITY BETWEEN PROFITABILITY CLASSES
#
# Compares the annual percentage distributions of classes
# 1 and 2 using cosine similarity.
#
# Values approaching 1 indicate similar spatial distributions.
# ============================================================

cosine_similarity <- function(x, y) {

  denominator <- sqrt(
    sum(x^2, na.rm = TRUE) *
      sum(y^2, na.rm = TRUE)
  )

  if (
    !is.finite(denominator) ||
    denominator == 0
  ) {
    return(NA_real_)
  }

  sum(
    x * y,
    na.rm = TRUE
  ) / denominator
}


