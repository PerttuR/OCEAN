# =========================
# 5. CREATE MATRICES FOR EACH PROFITABILITY CLASS
#
# Rows:
#   C-squares
#
# Columns:
#   Years
# =========================

create_class_proportion_matrix <- function(
    class_number
) {

  class_wide <- kan_lk_similarity_long %>%
    dplyr::filter(
      kan_lk == class_number
    ) %>%
    dplyr::select(
      Csquare,
      Year,
      FishingHoursProportion
    ) %>%
    tidyr::pivot_wider(
      names_from = Year,
      values_from = FishingHoursProportion,
      values_fill = 0
    ) %>%
    dplyr::right_join(
      tibble::tibble(
        Csquare = all_kan_lk_csquares
      ),
      by = "Csquare"
    ) %>%
    dplyr::arrange(
      match(
        Csquare,
        all_kan_lk_csquares
      )
    )

  year_columns <- as.character(
    years_kan_lk
  )

  missing_year_columns <- setdiff(
    year_columns,
    names(class_wide)
  )

  if (length(missing_year_columns) > 0) {
    stop(
      "Missing year columns for profitability class ",
      class_number,
      ": ",
      paste(
        missing_year_columns,
        collapse = ", "
      )
    )
  }

  class_wide %>%
    dplyr::mutate(
      dplyr::across(
        dplyr::all_of(year_columns),
        ~ dplyr::coalesce(.x, 0)
      )
    ) %>%
    dplyr::select(
      Csquare,
      dplyr::all_of(year_columns)
    )
}


