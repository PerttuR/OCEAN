table1 %>%
  filter(VE_REF == "FIN-1142-T", Year == 2017) %>%
  summarise(
    sum_FishingHour = sum(INTV, na.rm = TRUE)
  )



  ##start here ###


kg_cols <- grep("^LE_KG_", colnames(table1), value = TRUE)
kg_cols <- setdiff(kg_cols, c("LE_KG_TOT", "LE_KG_TOTAL", "LE_KG_SUM_SPECIES", "LE_KG_RATIO"))

table1$LE_KG_SUM_SPECIES <- rowSums(table1[, kg_cols], na.rm = TRUE)
table1$LE_KG_RATIO <- table1$LE_KG_TOT / table1$LE_KG_SUM_SPECIES




